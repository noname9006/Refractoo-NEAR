# NOTE: anything prefixed VITE_ is bundled into the client and is PUBLIC.
# VITE_ values are also inlined AT BUILD TIME — changing one needs a rebuild.

# ── Network mode ────────────────────────────────────────────────────────────
# mainnet — Ethereum / Arbitrum / Optimism / Base / Polygon.
#           Confidential tokens via Zama Protocol (Ethereum) + Inco (Base).
# testnet — Sepolia / Arbitrum Sepolia / Base Sepolia.
#           The only mode where Fhenix CoFHE works (it has no mainnet
#           deployment). USD figures are proxied from mainnet prices and are
#           labelled as such — they are not real value.
# Defaults to mainnet when unset. In `npm run dev` you can also switch modes at
# runtime from Settings → Network without a rebuild.
VITE_NETWORK_MODE=mainnet

# Restrict which confidential-token stacks are probed (comma-separated:
# zama, cofhe, inco). Leave blank to use every stack the active mode supports.
VITE_FHE_STACKS=

# ── Public chain data ───────────────────────────────────────────────────────
# Etherscan V2 unified API key (one key for all supported chains, mainnet and
# testnet). Balances work without it; transaction history does not.
VITE_ETHERSCAN_KEY=
# NearBlocks API key for NEAR transaction history (optional). Get a free key at
# https://nearblocks.io/apis — free tier: 6 calls/min, 333/day, 10k/month.
# Keyless calls are heavily rate-limited (HTTP 429); without a key, or once the
# quota runs out, the app falls back to FastNEAR (no key needed).
VITE_NEARBLOCKS_KEY=

# ── Fhenix CoFHE (testnet mode only) ───────────────────────────────────────
# Address(es) of deployed ConfidentialDemo contracts (contracts/README.md).
# Without any, the CoFHE stack has no contract to read and reports as
# unconfigured. Deploy more than one copy to track multiple sealed values and
# list them comma-separated here. VITE_COFHE_DEMO_ADDRESS (single address) and
# VITE_CONFIDENTIAL_DEMO_ADDRESS (old name) are also honoured and merged in.
VITE_COFHE_DEMO_ADDRESSES=
VITE_COFHE_DEMO_ADDRESS=

# ── Zama Protocol ──────────────────────────────────────────────────────────
# Wrapper-registry addresses for both Ethereum and Sepolia are built in (taken
# from @zama-fhe/sdk's own chain descriptors), so nothing needs setting here.
# Only override if Zama redeploys the Sepolia registry.
VITE_ZAMA_SEPOLIA_REGISTRY=

# ── Inco Lightning ─────────────────────────────────────────────────────────
# Inco ships no wrapper registry, so confidential token addresses must be listed
# explicitly (comma-separated). Testnet (Base Sepolia) only; the mainnet Base
# list lives in src/config/networks.mainnet.js.
VITE_INCO_TESTNET_TOKENS=

# ── Server-side (NOT bundled into the client) ──────────────────────────────
# CoinGecko API key for the token-list server (server/index.js).
# Without a key the free public tier is used (~10 req/min, sufficient for daily
# refresh). Demo key: x-cg-demo-api-key header. Pro key (starts with "CG-"):
# x-cg-pro-api-key header.
COINGECKO_API_KEY=
# ── NEAR (hackathon work) ──────────────────────────────────────────────────
# NEAR Intents partner API key (https://portal.intents.aurora.dev). Used by the
# browser to read the user's Confidential Intents (private-shard) balances after
# a wallet signature. It identifies this app as the integrator, not the user, and
# is bundled into the client like VITE_ETHERSCAN_KEY.
VITE_AURORA_INTENTS_API_KEY=
# Same key for Node spike scripts (spike/intents-node.mjs).
AURORA_INTENTS_API_KEY=

# NEAR AI Cloud key (https://cloud.near.ai or nearbuilders.org/dashboard).
# Server-side / spike scripts only — the app asks the user for their own key.
NEARAI_API_KEY=
